#!/bin/sh

# apic - dump album art image for the given arguments

# To easily view the output on the console, use:
#   apic file.mp3 | convert - jpg:- | jp2a -

# Use the tools from the beets uv tool environment (see setup.sh).
beets_bin="$(uv tool dir)/beets/bin"

apic() {
  "$beets_bin/mid3v2" --list-raw "$1" | grep APIC | sed 's/.*data=//'
}

tmpfile=$(mktemp --suffix=.py)
echo "import sys" > "$tmpfile"
while [ $# -gt 0 ]
do
  f=$1
  shift
  echo "sys.stdout.buffer.write(" >> "$tmpfile"
  if [ "$(apic "$f")" ]
  then
    apic "$f" >> "$tmpfile"
  else
    echo "b'')" >> "$tmpfile"
  fi
done
"$beets_bin/python" "$tmpfile"
rm "$tmpfile"
